# Reglas Suricata educativas para laboratorio NSM (Cap. 4.4)
# Rango de SID local reservado: 9000001 - 9000099

# 1. Detectar User-Agent de prueba automatizada contra aplicaciones HTTP del laboratorio
alert http $HOME_NET any -> $HOME_NET any (msg:"LAB SEC Escaneo o Sonda HTTP con User-Agent de Auditoria"; flow:to_server,established; http.user_agent; content:"Lab-Audit-Probe"; nocase; classtype:web-application-activity; sid:9000001; rev:1;)

# 2. Detectar acceso HTTP a archivos ocultos sensibles (.env o .git/config)
alert http any any -> $HOME_NET any (msg:"LAB SEC Solicitud sospechosa hacia archivo .env o .git"; flow:to_server,established; http.uri; pcre:"/(\.env|\.git\/config)/i"; classtype:attempted-recon; sid:9000002; rev:1;)

# 3. Detectar transferencia de binario Windows PE (firma MZ) sobre HTTP en texto claro
alert http any any -> $HOME_NET any (msg:"LAB SEC Posible descarga de ejecutable PE sobre HTTP sin cifrar"; flow:to_client,established; file.data; content:"MZ"; offset:0; depth:2; content:"This program cannot be run in DOS mode"; distance:0; within:200; classtype:policy-violation; sid:9000003; rev:1;)

# 4. Detectar umbral de multiples intentos SSH entrantes en 60 segundos
alert tcp any any -> $HOME_NET 22 (msg:"LAB SEC Posible fuerza bruta SSH contra servidor de laboratorio"; flow:to_server,established; threshold:type both, track by_src, count 6, seconds 60; classtype:attempted-admin; sid:9000004; rev:1;)
